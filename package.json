{
  "name": "kisaragi-site",
  "version": "1.0.0",
  "description": "Kisaragi's website.",
  "main": "dist/server/server.js",
  "scripts": {
    "start": "npm run build && npm run web",
    "web": "node --max_old_space_size=4096 dist/server/server.js",
    "build": "npm run clean && npm run bundle-web && npm run bundle-server && npm run cname && npm run postfix",
    "cname": "echo \"kisaragi.moe\" > dist/client/CNAME",
    "bundle-web": "rsbuild build --config rsbuild.client.ts",
    "bundle-server": "rsbuild build --config rsbuild.server.ts",
    "postfix": "node postfix.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist/client",
    "clean": "del-cli ./dist"
  },
  "homepage": "https://kisaragi.moe/",
  "keywords": [
    "kisaragi",
    "bot",
    "discord",
    "moe",
    "kawaii",
    "cute"
  ],
  "author": "Moebytes",
  "license": "CC BY-NC 4.0",
  "dependencies": {
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-favicon": "^2.0.4",
    "helmet": "^8.1.0",
    "history": "^5.3.0",
    "html-react-parser": "^5.2.17",
    "jquery": "^4.0.0",
    "mime": "^4.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.13.1",
    "react-router-hash-link": "^2.4.3",
    "react-slide-toggle": "^0.3.5",
    "react-string-replace": "^2.0.1",
    "reactjs-localstorage": "^1.0.1",
    "renamer": "^5.0.2"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-less": "^1.6.2",
    "@rsbuild/plugin-node-polyfill": "^1.4.4",
    "@rsbuild/plugin-react": "^1.4.6",
    "@rsbuild/plugin-type-check": "^1.3.4",
    "@types/express": "^5.0.6",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-router-hash-link": "^2.4.9",
    "del-cli": "^7.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.3"
  }
}
